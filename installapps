#!/bin/bash
# mac_setup.sh — Teacher Mac Setup Script
# Installs Chrome, Google Drive, MS Office + sensible system tweaks
# Run with: bash ~/Downloads/mac_setup.sh

set -e  # Exit immediately if any command fails

echo "=== Teacher Mac Setup Script ==="
echo ""

# ── 1. Install Homebrew if not present ──────────────────────────────────────
if ! command -v brew &>/dev/null; then
  echo "Installing Homebrew..."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

  # Add Homebrew to PATH for Apple Silicon Macs
  if [[ $(uname -m) == "arm64" ]]; then
    echo 'eval "$(/opt/homebrew/bin/brew shellenv)"' >> "$HOME/.zprofile"
    eval "$(/opt/homebrew/bin/brew shellenv)"
  fi
else
  echo "Homebrew already installed — skipping."
fi

echo ""

# ── 2. Update Homebrew ───────────────────────────────────────────────────────
echo "Updating Homebrew..."
brew update
echo ""

# ── 3. Install apps ─────────────────────────────────────────────────────────
install_cask() {
  local cask="$1"
  local name="$2"

  if brew list --cask "$cask" &>/dev/null; then
    echo "$name already installed — skipping."
  else
    echo "Installing $name..."
    brew install --cask "$cask"
    echo "$name installed."
  fi
  echo ""
}

install_cask "google-chrome"     "Google Chrome"
install_cask "google-drive"      "Google Drive"
install_cask "microsoft-office"  "Microsoft Office"

# ── 4. Disable automatic updates ────────────────────────────────────────────
echo "Disabling automatic updates..."

# Disable macOS system auto-updates
sudo defaults write /Library/Preferences/com.apple.SoftwareUpdate AutomaticCheckEnabled -bool false
sudo defaults write /Library/Preferences/com.apple.SoftwareUpdate AutomaticDownload -bool false
sudo defaults write /Library/Preferences/com.apple.SoftwareUpdate CriticalUpdateInstall -bool false
sudo defaults write /Library/Preferences/com.apple.SoftwareUpdate ConfigDataInstall -bool false

# Disable App Store auto-updates
sudo defaults write /Library/Preferences/com.apple.commerce AutoUpdate -bool false

# Disable Homebrew auto-update on every brew command
echo 'export HOMEBREW_NO_AUTO_UPDATE=1' >> "$HOME/.zprofile"

echo "Automatic updates disabled."
echo ""

# ── 5. Finder tweaks ────────────────────────────────────────────────────────
echo "Configuring Finder..."

# Default view: List view
defaults write com.apple.finder FXPreferredViewStyle -string "Nlsv"

# Always show file extensions
defaults write NSGlobalDomain AppleShowAllExtensions -bool true

# Disable the "Are you sure you want to open this?" quarantine dialog
defaults write com.apple.LaunchServices LSQuarantine -bool false

# Restart Finder to apply changes
killall Finder

echo "Finder configured."
echo ""

# ── 6. Dock tweaks ──────────────────────────────────────────────────────────
echo "Configuring Dock..."

# Speed up Dock show/hide animation (0.15s instead of default 0.5s)
defaults write com.apple.dock autohide-time-modifier -float 0.15
defaults write com.apple.dock autohide-delay -float 0

# Enable Dock auto-hide
defaults write com.apple.dock autohide -bool true

# Restart Dock to apply changes
killall Dock

echo "Dock configured."
echo ""

# ── 7. Display and screen saver ─────────────────────────────────────────────
echo "Configuring display settings..."

# Disable screen saver
defaults write com.apple.screensaver idleTime -int 0

# Set display sleep to 30 minutes (useful on classroom projectors/screens)
sudo pmset -a displaysleep 30

echo "Display settings configured."
echo ""

# ── 8. Enable firewall ──────────────────────────────────────────────────────
echo "Enabling firewall..."

sudo /usr/libexec/ApplicationFirewall/socketfilterfw --setglobalstate on

echo "Firewall enabled."
echo ""

# ── 9. Done ─────────────────────────────────────────────────────────────────
echo "Setup complete! A restart is recommended to apply all changes."
echo ""
echo "Next steps:"
echo "  - Open Google Drive and sign in with your Google account."
echo "  - Open any Office app (Word, Excel, etc.) and sign in with"
echo "    your Microsoft 365 account to activate."
echo "  - Restart the Mac to apply all system tweaks."
